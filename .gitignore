# This repo publishes app/, docs/, connecting/ and the CI workflow only
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/app/
!/docs/
!/connecting/
!/.github/

/app/build/
# vendor firmware files and the local network scans stay private
/docs/raw/sysdisk-2026-10-15/
/docs/raw/2026-10-15_lan-sweep.txt
/docs/raw/2026-10-15_ddcs-scan.txt
!/.gitattributes
/app/tools/ssh/out/

# connecting/ runtime artifacts (a generated private key, state, backups, venv)
/connecting/ssh_key
/connecting/ssh_key.pub
/connecting/connection.txt
/connecting/backup/
/connecting/files/.venv/
/connecting/files/__pycache__/
/connecting/files/state.json
/app/install/logo/logo-placeholder.*
