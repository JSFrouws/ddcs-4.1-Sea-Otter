# files that run on the controller or in WSL must keep LF line ends
*.sh text eol=lf
app/install/usb/** text eol=lf
app/install/usb/ddcsv4/ddcsv4.out text eol=lf
*.bat text eol=crlf
connecting/files/src/*.c text eol=lf
connecting/DDCS4.1_temporary_app binary
connecting/files/dropbearmulti binary
# binaries in the USB package: never touch their bytes (overrides the text rule above)
app/install/usb/ddcsv4/*.ko binary
app/install/usb/ddcsv4/*.bmp binary
*.png binary
